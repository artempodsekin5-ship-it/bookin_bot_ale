# Токен вашего бота от @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ID администратора (или нескольких через запятую: 12345678,87654321)
ADMIN_IDS=12345678

# Опционально: Прокси-сервер (если прямое подключение к Telegram блокируется или тормозит)
# Примеры: socks5://127.0.0.1:10808 или http://127.0.0.1:7890 или socks5://user:pass@host:port
# PROXY_URL=socks5://127.0.0.1:10808

# Опционально: Таймаут сетевых запросов в секундах (по умолчанию: 60)
# REQUEST_TIMEOUT=60
